      "id": "email-day",
      "node": "email",
      "scope": "service",
      "severity": "warn",
      "label": "E-mails por dia",
      "value": "100 no plano gratuito",
      "note": "Um dia de promoção estoura a cota e os pedidos ficam sem confirmação."
    },
    {
      "id": "db-backup",
      "node": "db",
      "scope": "app",
      "severity": "crit",
      "label": "Backup",
      "value": "Sem backup automático",
      "note": "O dump manual roda só quando alguém lembra. Uma falha do disco perde os pedidos."
    },
    {
      "id": "queue-mem",
      "node": "queue",
      "scope": "hosting",
      "severity": "warn",
      "label": "Memória da fila",
      "value": "512 MB antes de bloquear publicações",
      "note": "Se o worker parar, a fila enche em cerca de 40 minutos de vendas normais."
    },
    {
      "id": "worker-conc",
      "node": "worker",
      "scope": "app",
      "severity": "warn",
      "label": "Concorrência",
      "value": "1 processo, 10 pedidos por vez",
      "note": "Um pedido travado no e-mail atrasa os seguintes."
    },
    {
      "id": "pay-rate",
      "node": "payments",
      "scope": "service",
      "severity": "info",
