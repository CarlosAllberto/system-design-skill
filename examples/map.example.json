  "limits": [
    {
      "id": "api-ram",
      "node": "api",
      "scope": "hosting",
      "severity": "warn",
      "label": "Memória",
      "value": "4 GB compartilhados entre API, worker, fila e Postgres",
      "note": "Tudo roda na mesma máquina."
    },
    {
      "id": "db-conn",
      "node": "db",
      "scope": "app",
      "severity": "crit",
      "label": "Conexões simultâneas",
      "value": "100 conexões, sem pooler",
      "note": "A API e o worker abrem conexões próprias e o pico da Black Friday passa disso."
    },
    {
      "id": "db-disk",
      "node": "db",
      "scope": "hosting",
      "severity": "info",
      "label": "Disco",
